# Managed by chezmoi — edit private_dot_ssh/private_config in the source repo.
# Private keys are NEVER stored here or in git. Each machine generates its own
# ~/.ssh/id_ed25519 and registers the .pub with GitHub.

Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # macOS-only; Linux skips it rather than erroring.
  IgnoreUnknown UseKeychain
  UseKeychain yes

Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

