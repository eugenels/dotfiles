#!/usr/bin/env bash
set -euo pipefail
cd "$HOME"
chezmoi update
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
brew update
brew upgrade --greedy
{{ else -}}
sudo apt-get update
sudo apt-get upgrade -y
flatpak update --user -y
{{ end -}}
flox upgrade -d "$HOME"
flox activate -d "$HOME" -m run -- pi update --extensions --no-approve
for target in claude pi codex; do
    flox activate -d "$HOME" -m run -- herdr integration install "$target"
done
