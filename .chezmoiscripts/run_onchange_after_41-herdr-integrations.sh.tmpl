#!/usr/bin/env bash
set -euo pipefail
# Manifest: {{ include "dot_config/flox/manifest.toml" | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}
for target in claude pi codex; do
    flox activate -d "$HOME" -m run -- herdr integration install "$target"
done
