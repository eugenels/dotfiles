#!/usr/bin/env bash
set -euo pipefail
# Reinstall when herdr's Flox entry changes; dotfiles-update covers upgrades.
# Herdr: {{ regexFindAll "(?m)^herdr\\..*$" (include "packages/flox-manifest.toml") -1 | join "\n" | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}
for target in claude pi codex; do
    flox activate -d "$HOME" -m run -- herdr integration install "$target"
done
