{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail
# Packages: {{ include "packages/flatpak.txt" | sha256sum }}
flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
xargs flatpak install --user -y flathub < "{{ .chezmoi.sourceDir }}/packages/flatpak.txt"
{{- end -}}
