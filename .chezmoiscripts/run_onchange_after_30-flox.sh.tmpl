#!/usr/bin/env bash
set -euo pipefail
# Manifest: {{ include "packages/flox-manifest.toml" | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}
flox config --set disable_metrics true
if [ ! -d "$HOME/.flox" ]; then
    flox init -d "$HOME"
fi
flox edit -d "$HOME" -f "{{ .chezmoi.sourceDir }}/packages/flox-manifest.toml"
