#!/usr/bin/env bash
#
# Creates the $HOME flox environment on first run, then keeps it in sync with
# dot_config/flox/manifest.toml. Runs after 20-packages so that on macOS the
# flox cask is already installed.
#
# manifest hash: {{ include "dot_config/flox/manifest.toml" | sha256sum }}
#
set -euo pipefail

if ! command -v flox >/dev/null 2>&1; then
    echo "==> flox: skipped (not installed)"
    exit 0
fi

if [ ! -d "$HOME/.flox" ]; then
    echo "==> flox init"
    flox init -d "$HOME"
fi

echo "==> flox edit (this can take a while on first run)"
flox edit -d "$HOME" -f "$HOME/.config/flox/manifest.toml"
