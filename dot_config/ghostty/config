# Ghostty configuration
# Docs: https://ghostty.org/docs/config/reference

font-family = JetBrainsMono Nerd Font Mono
font-size = 13

# Appearance
# Follow system appearance; ANSI colors also theme terminal applications.
theme = light:Flexoki Light,dark:Flexoki Dark
window-padding-x = 8
window-padding-y = 8

# macOS
macos-option-as-alt = true
