// Only non-default settings: https://zed.dev/docs/configuring-zed
{
  "git_panel": {
    "tree_view": true
  },
  "agent": {
    "auto_compact": {
      "threshold": "80%"
    },
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "enable_feedback": false,
    "thinking_display": "always_collapsed"
  },
  "centered_layout": {
    "right_padding": 0.2,
    "left_padding": 0.2
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "model": "anthropic/claude-fable-5-1",
        "thought_level": "xhigh"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "xhigh",
        "model": "claude-fable-5-1[1m]"
      },
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": false
  },
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Flexoki Light",
    "dark": "Flexoki Dark",
  },
}
